{
  "name": "tapkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/desktop-build.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:e2e": "node scripts/e2e.mjs",
    "test:live": "node scripts/live.mjs",
    "test:security": "vitest run --config vitest.config.ts --project integration P00-03",
    "test:recovery": "node scripts/not-implemented.mjs recovery",
    "test:perf": "node scripts/perf.mjs",
    "eval:agent": "node scripts/not-implemented.mjs eval",
    "pack:dir": "node scripts/not-implemented.mjs packaging",
    "dist:win": "node scripts/not-implemented.mjs installer",
    "docs:check": "node scripts/docs-check.mjs",
    "format": "prettier --write .",
    "runtime:fetch": "node scripts/runtime-fetch.mjs",
    "test:repro": "node scripts/repro.mjs",
    "helper:build": "node scripts/helper-build.mjs",
    "runtime:probe": "node scripts/runtime-probe.mjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "electron-builder": "26.15.3",
    "@electron/rebuild": "4.2.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "@babel/parser": "8.0.5"
  }
}
