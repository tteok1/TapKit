* text=auto eol=lf

# Keep screenshot assets binary.
*.png binary

# Preserve raw test output, including line endings and reporter whitespace.
docs/evidence/**/*.log -text -whitespace

# Captured Playwright source excerpts and PDF text are raw evidence as well.
docs/evidence/P05-03/**/desktop-failures/** -text -whitespace
docs/evidence/P05-03/**/milestone-failure/** -text -whitespace
docs/evidence/P05-02/exported/extracted.txt -text -whitespace
docs/evidence/P05-03/**/exported/extracted.txt -text -whitespace

# P07 generated office/data exports are byte-preserved acceptance evidence.
docs/evidence/P07-*/**/*.svg -text -whitespace
docs/evidence/P07-*/**/*.html -text -whitespace
docs/evidence/P07-*/**/*.csv -text -whitespace

# CI rerun manifests hash these generated Markdown exports byte for byte.
docs/evidence/P07-03/ci-fix-2026-10-30/retest-artifacts/**/*.md -text -whitespace
docs/evidence/P07-03/ci-fix-2026-10-30/font-acceptance/retest-artifacts/**/*.md -text -whitespace
