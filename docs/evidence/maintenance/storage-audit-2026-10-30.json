  "causes": [
    {
      "finding": "Repeated test profiles accumulate and retain database migration backups. New databases traverse schema versions 1..18 and back up the complete database before every step. 86548 migration backup files total 40310759424 bytes.",
      "sources": [
        "packages/storage/src/foundation.ts:130",
        "packages/storage/src/foundation.ts:575",
        "tests/integration/P02-03.history.test.ts:42",
        "tests/integration/P02-03.history.test.ts:66"
      ]
    },
    {
      "finding": "Representative test teardown closes processes and stores without removing its mkdtemp directory. Repeated integration/Electron runs retain both database copies and Chromium profile caches.",
      "sources": [
        "tests/integration/P02-03.history.test.ts:42",
        "tests/e2e/P00-01.shell.spec.ts:9",
        "tests/e2e/P00-01.shell.spec.ts:22",
        "tests/e2e/P02-01.form-controls.spec.ts:23",
        "tests/e2e/P02-01.form-controls.spec.ts:141"
      ]
    },
    {
      "finding": "Daily backup retention removes daily-marked backups beyond seven days; it does not prune backups/migrations.",
      "sources": [
        "packages/storage/src/blobs.ts:431"
      ]
    },
    {
      "finding": "The oversized-file test leaves a 100 MiB + 1 byte fixture per run. Thirteen such files remain; this is a secondary contributor, not the main cause.",
      "sources": [
        "tests/integration/P03-01.file-selections.test.ts:8",
        "tests/integration/P03-01.file-selections.test.ts:119"
      ]
    },
    {
      "finding": "pack:dir creates timestamped self-contained development directories, copies Node/Python/Git/LibreOffice, Electron and dependencies, and updates latest.json without pruning previous snapshots. Two copies remain, approximately 3.25 GiB each.",
      "sources": [
        "scripts/pack-dir.mjs:17",
        "scripts/pack-dir.mjs:52",
        "scripts/pack-dir.mjs:320"
      ]
    },
    {
      "finding": "Bootstrap retains downloaded archives as well as extracted runtimes, installed dependencies and build caches. Rust is a full development distribution; LibreOffice is the largest bundled application runtime.",
      "sources": [
        "scripts/runtime-fetch.mjs:119",
        "scripts/runtime-fetch.mjs:165",
        "scripts/bootstrap.mjs:6",
        "runtime-lock.json"
      ]
    }
  ],
